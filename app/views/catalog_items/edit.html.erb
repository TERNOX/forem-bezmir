<% content_for :page_title, t("views.catalog_items.edit.title") %>

<div class="crayons-layout crayons-layout--1-col">
  <main class="crayons-layout__content" id="main-content">
    <%= render "shared/catalog_toggle" %>

    <h1 class="fs-2xl fw-bold mb-4"><%= t("views.catalog_items.edit.heading") %></h1>

    <%= render "catalog_items/form",
               catalog_item: @catalog_item,
               form_url: catalog_item_path(@catalog_item),
               submit_label: t("views.catalog_items.edit.submit") %>
  </main>
</div>
