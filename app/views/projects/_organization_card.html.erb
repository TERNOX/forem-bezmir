<% summary_text = strip_tags(organization.summary.to_s).squish %>
<% tagline_text = strip_tags(organization.tag_line.to_s).squish %>
<% description_text = summary_text.presence || tagline_text.presence || t("views.projects.card.no_summary") %>
<% searchable = [organization.name, summary_text, tagline_text].compact.join(" ").squish.mb_chars.downcase.to_s %>

<article
  class="projects-card crayons-card p-5"
  data-project-card
  data-name="<%= organization.name.mb_chars.downcase.to_s %>"
  data-created-at="<%= organization.created_at.to_i %>"
  data-articles-count="<%= organization.articles_count %>"
  data-searchable="<%= searchable %>"
>
  <a href="<%= organization.path %>" class="projects-card__header">
    <span class="projects-card__image-wrapper">
      <img
        src="<%= organization.profile_image_url_for(length: 120) %>"
        alt="<%= organization.name %>"
        width="72"
        height="72"
        class="projects-card__logo"
        loading="lazy"
      />
    </span>
    <div class="projects-card__title">
      <h2 class="projects-card__name"><%= organization.name %></h2>
      <% if tagline_text.present? %>
        <p class="projects-card__tagline color-base-70 fs-s"><%= tagline_text %></p>
      <% end %>
    </div>
  </a>

  <p class="projects-card__summary fs-s color-base-70 truncate-at-3"><%= description_text %></p>

  <div class="projects-card__meta color-base-70 fs-xs">
    <span class="projects-card__stat">
      <%= t("views.projects.card.posts_count", count: organization.articles_count) %>
    </span>
    <span class="projects-card__stat">
      <%= t("views.projects.card.created_at", date: l(organization.created_at.to_date, format: :long)) %>
    </span>
  </div>

  <div class="projects-card__actions">
    <a class="crayons-btn crayons-btn--ghost" href="<%= organization.path %>">
      <%= t("views.projects.card.visit") %>
    </a>
  </div>
</article>
