<% content_for :page_title, t("views.top_users.title") %>

<div class="crayons-layout crayons-layout--limited top-users-page px-2 m:px-0">
  <div class="crayons-card p-4 m:p-6 mb-4">
    <h1 class="fs-3xl fw-bold mb-2"><%= t("views.top_users.title") %></h1>
    <p class="color-base-70 mb-0"><%= t("views.top_users.description") %></p>
  </div>

  <ol class="top-users__list list-none m-0 p-0 crayons-card">
    <% @users.each_with_index do |user, index| %>
      <li class="top-users__item border-base-10 border-0 border-b px-4 py-6">
        <div class="flex items-center gap-4 flex-wrap">
          <div class="top-users__rank fs-xl fw-bold color-base-60 text-center">#<%= index + 1 %></div>
          <div class="flex-1 min-w-0">
            <%= render "users/liquid", user: user, user_path: user.path %>
          </div>
          <div class="top-users__score ml-auto text-right">
            <div class="color-base-60 fw-medium fs-s"><%= t("views.top_users.reputation_label") %></div>
            <div class="fs-xl fw-bold color-base-90"><%= number_with_delimiter(user.reputation_score) %></div>
          </div>
        </div>
      </li>
    <% end %>
  </ol>
</div>
