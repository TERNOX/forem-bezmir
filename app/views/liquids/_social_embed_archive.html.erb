<%# Fork-only: durable, self-hosted archive card for an embedded social post.
    Shown as a fallback when the original post/account is gone. locals: snapshot %>
<div class="ltag-social-embed__archive">
  <article class="ltag-social-embed__card">
    <header class="ltag-social-embed__head">
      <% if snapshot.author_avatar_url.present? %>
        <img class="ltag-social-embed__avatar" src="<%= snapshot.author_avatar_url %>" alt="" width="48" height="48" loading="lazy" onerror="this.style.display='none'">
      <% end %>
      <div class="ltag-social-embed__meta">
        <span class="ltag-social-embed__name"><%= snapshot.author_name.presence || snapshot.author_handle %></span>
        <% if snapshot.author_handle.present? %>
          <span class="ltag-social-embed__handle">@<%= snapshot.author_handle %></span>
        <% end %>
      </div>
      <span class="ltag-social-embed__logo ltag-social-embed__logo--<%= snapshot.platform %>" aria-hidden="true">
        <% if snapshot.platform == "bluesky" %>
          <svg viewBox="0 0 568 501" width="20" height="20" fill="currentColor"><path d="M123.121 33.664C188.241 82.553 258.281 181.68 284 234.873c25.719-53.193 95.759-152.32 160.879-201.209C491.866-1.611 568-28.906 568 57.947c0 17.346-9.945 145.713-15.778 166.555-20.275 72.453-94.155 90.933-159.875 79.748C507.222 323.8 536.444 388.56 473.333 453.32c-119.86 122.992-172.272-30.859-185.702-70.281-2.462-7.227-3.614-10.608-3.631-7.733-.017-2.875-1.169.506-3.631 7.733-13.43 39.422-65.842 193.273-185.702 70.281-63.111-64.76-33.889-129.52 80.986-149.071-65.72 11.185-139.6-7.295-159.875-79.748C9.945 203.66 0 75.293 0 57.947 0-28.906 76.134-1.611 123.121 33.664Z"/></svg>
        <% else %>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        <% end %>
      </span>
    </header>

    <% if snapshot.text_html.present? %>
      <div class="ltag-social-embed__text"><%= snapshot.text_html.html_safe %></div>
    <% end %>

    <% if snapshot.photos.any? %>
      <div class="ltag-social-embed__media ltag-social-embed__media--count-<%= [snapshot.photos.size, 4].min %>">
        <% snapshot.photos.first(4).each do |photo| %>
          <a class="ltag-social-embed__photo-link" href="<%= photo["url"] %>" target="_blank" rel="nofollow noopener">
            <img class="ltag-social-embed__photo" src="<%= photo["url"] %>" alt="<%= photo["alt"] %>" loading="lazy">
          </a>
        <% end %>
      </div>
    <% end %>

    <footer class="ltag-social-embed__foot">
      <span class="ltag-social-embed__archived" title="<%= I18n.t("liquid_tags.social_embed.archived_note") %>">
        <svg class="ltag-social-embed__foot-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8M10 12h4"/></svg>
        <span><%= I18n.t("liquid_tags.social_embed.archived_badge") %><% if snapshot.posted_at.present? %> · <time datetime="<%= snapshot.posted_at.iso8601 %>"><%= snapshot.posted_at.strftime("%-d.%m.%Y") %></time><% end %></span>
      </span>
      <a class="ltag-social-embed__source" href="<%= snapshot.source_url %>" target="_blank" rel="nofollow noopener">
        <span><%= I18n.t("liquid_tags.social_embed.view_original") %></span>
        <svg class="ltag-social-embed__foot-icon" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
      </a>
    </footer>
  </article>
</div>
