<% thumbnail_id = id.split("?").first %>
<% play_label = t("views.youtube.play_video", default: "Play YouTube video") %>
<% player_title = t("views.youtube.video_title", default: "YouTube video player") %>
<div
  class="embedded-video"
  data-youtube-id="<%= id %>"
  data-youtube-width="<%= width %>"
  data-youtube-height="<%= height %>"
  data-youtube-title="<%= player_title %>"
>
  <button type="button" class="embedded-video__trigger" aria-label="<%= play_label %>">
    <img
      class="embedded-video__thumbnail"
      src="https://img.youtube.com/vi/<%= thumbnail_id %>/sddefault.jpg"
      alt="<%= t("views.youtube.thumbnail_alt", default: "Preview image for the video") %>"
      loading="lazy"
      decoding="async"
    />
  </button>
</div>
<noscript>
  <iframe
    width="<%= width %>"
    height="<%= height %>"
    src="https://www.youtube-nocookie.com/embed/<%= id %>"
    title="<%= player_title %>"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen
    loading="lazy">
  </iframe>
</noscript>
