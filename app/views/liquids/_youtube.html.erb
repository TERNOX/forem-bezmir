<% thumbnail_id = id.split("?").first %>
<% embed_src = YoutubeUrl.normalize_embed_src("https://www.youtube.com/embed/#{id}") %>
<% play_label = t("views.youtube.play_video", default: "Запустити Youtube відео") %>
<% player_title = t("views.youtube.video_title", default: "YouTube відео програвач") %>
<div
  class="embedded-video"
  data-youtube-id="<%= id %>"
  data-youtube-width="100%"
  data-youtube-height="<%= height %>"
  data-youtube-title="<%= player_title %>"
  data-youtube-thumbnail-id="<%= thumbnail_id %>"
  data-youtube-src="<%= embed_src %>"
  data-youtube-play-label="<%= play_label %>"
  data-youtube-thumbnail-alt="<%= t("views.youtube.thumbnail_alt", default: "Обкладинка відео") %>"
>
  <button type="button" class="embedded-video__trigger" aria-label="<%= play_label %>" style="width: 100%;">
    <img
      class="embedded-video__thumbnail"
      src="https://img.youtube.com/vi/<%= thumbnail_id %>/mqdefault.jpg"
      data-youtube-thumbnail-quality="mqdefault"
      alt="<%= t("views.youtube.thumbnail_alt", default: "Обкладинка відео") %>"
      loading="lazy"
      decoding="async"
	  style="margin: 0px;width: 100%;max-height: 420px;  aspect-ratio: 16 / 9; object-fit: cover;    border-radius: 20px;    margin-bottom: 18px;"
    />
  </button>

</div>
<noscript>
  <iframe
    width="100%"

    src="<%= embed_src %>"
    title="<%= player_title %>"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    referrerpolicy="strict-origin-when-cross-origin"
        style="margin:0;aspect-ratio: 16 / 9;     margin: 0px; margin-bottom: 18px;"
    allowfullscreen
    loading="lazy">
  </iframe>
</noscript>
