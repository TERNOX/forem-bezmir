<%= form_for(Settings::General.new,
             url: admin_settings_general_settings_path,
             html: { data: {
               action: "submit->config#updateConfigurationSettings",
               testid: "flagAppealsForm"
             } }) do |f| %>
  <details class="crayons-card">
    <summary class="crayons-subtitle-2 p-6">Flag Appeals</summary>

    <div class="p-6 pt-0">
      <fieldset class="grid gap-4">
        <div class="crayons-field">
          <%= f.label :appeal_auto_unflag_threshold, "Appeal auto-unflag threshold", class: "crayons-field__label" %>
          <%= admin_config_description Constants::Settings::General.details[:appeal_auto_unflag_threshold][:description] %>
          <%= f.number_field :appeal_auto_unflag_threshold,
                             class: "crayons-textfield",
                             value: Settings::General.appeal_auto_unflag_threshold,
                             placeholder: Constants::Settings::General.details[:appeal_auto_unflag_threshold][:placeholder],
                             min: 0, max: 1.01, step: 0.01 %>
        </div>
      </fieldset>
      <%= render "update_setting_button", f: f %>
    </div>
  </details>
<% end %>
