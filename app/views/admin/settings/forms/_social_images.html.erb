<%= form_for(Settings::General.new,
             url: admin_settings_general_settings_path,
             html: { data: {
               action: "submit->config#updateConfigurationSettings",
               testid: "socialImagesForm"
             } }) do |f| %>
  <details class="crayons-card">
    <summary class="crayons-subtitle-2 p-6">Social Images</summary>

    <div class="p-6 pt-0">
      <fieldset class="grid gap-4">
        <div class="crayons-field crayons-field--checkbox">
          <%= f.check_box :quote_card_social_images, checked: Settings::General.quote_card_social_images, class: "crayons-checkbox" %>
          <div class="mt-0">
            <%= admin_config_label :quote_card_social_images %>
            <%= admin_config_description Constants::Settings::General.details[:quote_card_social_images][:description] %>
          </div>
        </div>
      </fieldset>
      <%= render "update_setting_button", f: f %>
    </div>
  </details>
<% end %>
