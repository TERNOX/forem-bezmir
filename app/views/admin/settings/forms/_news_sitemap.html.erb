<%= form_for(Settings::General.new,
             url: admin_settings_general_settings_path,
             html: { data: { action: "submit->config#updateConfigurationSettings" } }) do |f| %>
  <details class="crayons-card">
    <summary class="crayons-subtitle-2 p-6">News Sitemap</summary>
    <div class="p-6 pt-0">
      <fieldset class="grid gap-4">
        <div class="crayons-field">
          <%= admin_config_label :news_sitemap_tags, "Теги для News Sitemap" %>
          <%= admin_config_description I18n.t("lib.constants.settings.general.news_sitemap_tags.description") %>
          <%= f.text_field :news_sitemap_tags,
                           class: "crayons-textfield",
                           value: Settings::General.news_sitemap_tags.join(","),
                           placeholder: I18n.t("lib.constants.settings.general.news_sitemap_tags.placeholder") %>
        </div>
        <div class="crayons-field">
          <%= admin_config_label :news_sitemap_organization_ids, "ID організацій для News Sitemap" %>
          <%= admin_config_description I18n.t("lib.constants.settings.general.news_sitemap_organization_ids.description") %>
          <%= f.text_field :news_sitemap_organization_ids,
                           class: "crayons-textfield",
                           value: Settings::General.news_sitemap_organization_ids.join(","),
                           placeholder: I18n.t("lib.constants.settings.general.news_sitemap_organization_ids.placeholder") %>
        </div>
      </fieldset>
      <%= render "update_setting_button", f: f %>
    </div>
  </details>
<% end %>
