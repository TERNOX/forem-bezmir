<h1 class="crayons-title mb-6">Edit <%= @subforem.domain.presence || "Subforem" %></h1>
<%= render "form" %>
<% if @subforem.persisted? && policy(@subforem).destroy? %>
  <div class="crayons-card mt-6 p-6">
    <h2 class="crayons-subtitle-1 color-accent-danger mb-2"><%= t("views.admin.subforems.delete_heading") %></h2>
    <p class="color-secondary mb-4"><%= t("views.admin.subforems.delete_warning") %></p>
    <%= button_to t("views.admin.subforems.delete_button"),
        admin_subforem_path(@subforem),
        method: :delete,
        class: "crayons-btn crayons-btn--danger",
        data: { confirm: t("views.admin.subforems.delete_confirm", domain: @subforem.domain) } %>
  </div>
<% end %>
