<header class="admin__header mb-4 flex items-center justify-between">
  <div>
    <h1 class="fs-4xl fw-bold">Votings</h1>
    <p class="color-base-60">Community votings like “Гра року”: nominations with game covers, one ballot per member.</p>
  </div>
  <div class="flex gap-2">
    <%= link_to "Game catalog", admin_games_path, class: "crayons-btn crayons-btn--secondary" %>
    <%= link_to "New voting", new_admin_voting_path, class: "crayons-btn crayons-btn--branded" %>
  </div>
</header>

<div class="crayons-card p-4">
  <% if @votings.any? %>
    <table class="crayons-table w-100">
      <thead>
        <tr>
          <th>Title</th>
          <th>Address</th>
          <th>Status</th>
          <th>Dates</th>
          <th>Ballots</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @votings.each do |voting| %>
          <tr>
            <td><%= link_to voting.title, admin_voting_path(voting), class: "fw-medium" %></td>
            <td><code><%= voting.path %></code></td>
            <td><%= render "admin/votings/status_badge", voting: voting %></td>
            <td class="fs-s">
              <%= voting.opens_at ? l(voting.opens_at, format: :short) : "—" %> →
              <%= voting.closes_at ? l(voting.closes_at, format: :short) : "—" %>
            </td>
            <td><%= @ballot_counts[voting.id].to_i %></td>
            <td class="text-right">
              <div class="flex items-center justify-end gap-2">
                <%= link_to "Results", results_admin_voting_path(voting), class: "crayons-btn crayons-btn--ghost crayons-btn--s" %>
                <%= link_to "Edit", edit_admin_voting_path(voting), class: "crayons-btn crayons-btn--ghost crayons-btn--s" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-center py-6 color-base-60">No votings yet. Create the first one.</p>
  <% end %>
</div>
