<header class="admin__header mb-4 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="fs-4xl fw-bold">Results: <%= @voting.title %></h1>
    <p class="mt-1 flex flex-wrap items-center gap-2">
      <%= render "admin/votings/status_badge", voting: @voting %>
      <span class="color-base-60">
        <%= @results[:ballots_count] %> counted of <%= pluralize(@results[:submitted_count], "submitted ballot") %>
      </span>
    </p>
    <% excluded = ["unconfirmed accounts", "spam, suspended and banished members", "members with a score below #{@voting.min_user_score}"] %>
    <% excluded << "accounts created after the voting opened" if @voting.require_account_before_start? && @voting.opens_at.present? %>
    <p class="mt-1 fs-s color-base-60">Not counted: <%= excluded.join("; ") %>.</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= link_to "Back to voting", admin_voting_path(@voting), class: "crayons-btn crayons-btn--ghost" %>
    <%= link_to "Download CSV", results_admin_voting_path(@voting, format: :csv), class: "crayons-btn crayons-btn--secondary" %>
    <% if @voting.results_published? %>
      <%= button_to "Hide results", unpublish_results_admin_voting_path(@voting), method: :patch, class: "crayons-btn crayons-btn--secondary" %>
    <% else %>
      <% publish_confirm = if @voting.closed?
                             "Make the results public on the voting page? The public page will show a snapshot of the current count."
                           else
                             "Make the results public on the voting page? The voting has not closed yet: people can still change their ballots, " \
                               "and the public results will be a snapshot of this moment that does not follow later votes."
                           end %>
      <%= button_to "Publish results", publish_results_admin_voting_path(@voting), method: :patch, class: "crayons-btn crayons-btn--branded",
                                                                                   form: { data: { confirm: publish_confirm } } %>
    <% end %>
  </div>
</header>

<% if @voting.results_published? %>
  <% published_at = l(@voting.results_published_at, format: :short) %>
  <% republish_button = capture do %>
    <%= button_to "Update published results", republish_results_admin_voting_path(@voting), method: :patch, class: "crayons-btn crayons-btn--s mt-2",
                                                                                            form: { data: { confirm: "Replace the published results with the current count below?" } } %>
  <% end %>
  <% if @voting.results_snapshot.nil? %>
    <div class="crayons-notice crayons-notice--warning mb-4" data-results-snapshot="none">
      <p>Results were published on <%= published_at %>, before published results were frozen, so the public page still follows the live count. Update them to freeze the current count.</p>
      <%= republish_button %>
    </div>
  <% elsif @snapshot_matches %>
    <div class="crayons-notice crayons-notice--success mb-4" data-results-snapshot="matches">
      <p>Published on <%= published_at %>. The public page shows the numbers frozen at that moment, which match the current count below.</p>
    </div>
  <% else %>
    <div class="crayons-notice crayons-notice--warning mb-4" data-results-snapshot="differs">
      <p>Published on <%= published_at %>. The current count below differs from the published results: the public page still shows the numbers frozen at that moment.</p>
      <%= republish_button %>
    </div>
  <% end %>
<% end %>

<% @results[:categories].each do |category_result| %>
  <% category = category_result.category %>
  <section class="crayons-card p-4 mb-4">
    <h2 class="crayons-subtitle-1 mb-1"><%= category.title %></h2>
    <p class="fs-s color-base-60 mb-3">
      <%= pluralize(category_result.voters, "voter") %>
      <%= category.ranked? ? "· ranked, #{category.rank_points_list.join('-')} points" : "· 1 point per pick" %>
    </p>
    <table class="crayons-table w-100">
      <thead>
        <tr><th>#</th><th>Nominee</th><th class="w-50">Points</th><th>Votes</th><% if category.ranked? %><th>1st places</th><% end %></tr>
      </thead>
      <tbody>
        <% max = [category_result.max_points, 1].max %>
        <% category_result.rows.each do |row| %>
          <tr>
            <td><%= row.place || "—" %></td>
            <td><%= row.nominee.display_title %></td>
            <td>
              <div class="flex items-center gap-2">
                <div style="height: 8px; border-radius: 4px; background: var(--accent-brand); width: <%= (row.points * 100.0 / max).round(1) %>%; min-width: 2px;"></div>
                <span><%= row.points %></span>
              </div>
            </td>
            <td><%= row.votes %></td>
            <% if category.ranked? %><td><%= row.firsts %></td><% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if category_result.other_answers.any? %>
      <details class="mt-3">
        <summary class="cursor-pointer fs-s fw-medium">“Other” answers (<%= category_result.other_answers.sum(&:last) %>)</summary>
        <% nominees = category.nominees %>
        <% if nominees.any? %>
          <p class="mt-2 fs-s color-base-60">“Count as nominee” turns every ballot's answer into a pick of that nominee (the last place in a ranked nomination); a ballot that already has the nominee just loses the answer.</p>
        <% end %>
        <ul class="mt-2 fs-s flex flex-col gap-2">
          <% category_result.other_answers.each_with_index do |(text, count), index| %>
            <li class="flex flex-wrap items-center gap-2" data-other-answer="<%= text %>">
              <span><%= text %> — <%= count %></span>
              <% if nominees.any? %>
                <% total = @other_answer_totals.fetch([category.id, text], count) %>
                <% affected = total == count ? pluralize(total, "answer") : "#{pluralize(total, 'answer')} (#{count} on counted ballots)" %>
                <% merge_confirm = "Count all #{affected} “#{text}” as the selected nominee? This rewrites voters' ballots and cannot be undone." %>
                <%= form_with url: merge_other_answer_admin_voting_voting_category_path(@voting, category), method: :post, local: true,
                              class: "flex flex-wrap items-center gap-2", data: { confirm: merge_confirm } do %>
                  <input type="hidden" name="text" value="<%= text %>">
                  <label class="screen-reader-only" for="merge-<%= category.id %>-<%= index %>">Nominee for “<%= text %>”</label>
                  <div class="crayons-select">
                    <select id="merge-<%= category.id %>-<%= index %>" name="nominee_id" class="crayons-select__native fs-s">
                      <% nominees.each do |nominee| %>
                        <option value="<%= nominee.id %>"><%= nominee.display_title %></option>
                      <% end %>
                    </select>
                  </div>
                  <button type="submit" class="crayons-btn crayons-btn--s crayons-btn--secondary">Count as nominee</button>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </details>
    <% end %>
  </section>
<% end %>
