<header class="admin__header mb-4 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="fs-4xl fw-bold">Results: <%= @voting.title %></h1>
    <p class="mt-1 flex flex-wrap items-center gap-2">
      <%= render "admin/votings/status_badge", voting: @voting %>
      <span class="color-base-60">
        <%= pluralize(@results[:ballots_count], "counted ballot") %> (ballots of spam/suspended members are excluded)
      </span>
    </p>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= link_to "Back to voting", admin_voting_path(@voting), class: "crayons-btn crayons-btn--ghost" %>
    <%= link_to "Download CSV", results_admin_voting_path(@voting, format: :csv), class: "crayons-btn crayons-btn--secondary" %>
    <% if @voting.results_published? %>
      <%= button_to "Hide results", unpublish_results_admin_voting_path(@voting), method: :patch, class: "crayons-btn crayons-btn--secondary" %>
    <% else %>
      <%= button_to "Publish results", publish_results_admin_voting_path(@voting), method: :patch, class: "crayons-btn crayons-btn--branded",
                                                                                   form: { data: { confirm: "Make the results public on the voting page?" } } %>
    <% end %>
  </div>
</header>

<% @results[:categories].each do |category_result| %>
  <% category = category_result.category %>
  <section class="crayons-card p-4 mb-4">
    <h2 class="crayons-subtitle-1 mb-1"><%= category.title %></h2>
    <p class="fs-s color-base-60 mb-3">
      <%= pluralize(category_result.voters, "voter") %>
      <%= category.ranked? ? "· ranked, #{(1..category.max_choices).map { |r| category.points_for(r) }.join('-')} points" : "· 1 point per pick" %>
    </p>
    <table class="crayons-table w-100">
      <thead>
        <tr><th>#</th><th>Nominee</th><th class="w-50">Points</th><th>Votes</th><% if category.ranked? %><th>1st places</th><% end %></tr>
      </thead>
      <tbody>
        <% max = [category_result.max_points, 1].max %>
        <% category_result.rows.each_with_index do |row, index| %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= row.nominee.display_title %></td>
            <td>
              <div class="flex items-center gap-2">
                <div style="height: 8px; border-radius: 4px; background: var(--accent-brand); width: <%= (row.points * 100.0 / max).round(1) %>%; min-width: 2px;"></div>
                <span><%= row.points %></span>
              </div>
            </td>
            <td><%= row.votes %></td>
            <% if category.ranked? %><td><%= row.firsts %></td><% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if category_result.other_answers.any? %>
      <details class="mt-3">
        <summary class="cursor-pointer fs-s fw-medium">“Other” answers (<%= category_result.other_answers.sum(&:last) %>)</summary>
        <ul class="mt-2 fs-s">
          <% category_result.other_answers.each do |text, count| %>
            <li><%= text %> — <%= count %></li>
          <% end %>
        </ul>
      </details>
    <% end %>
  </section>
<% end %>
