<%= form_for [:admin, @voting], html: { class: "flex flex-col gap-6", multipart: true } do |f| %>
  <% if @voting.errors.any? %>
    <div class="crayons-notice crayons-notice--danger" role="alert">
      <%= @voting.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="crayons-field">
    <%= f.label :title, class: "crayons-field__label" %>
    <%= f.text_field :title, class: "crayons-textfield", required: true, placeholder: "Гра року 2026" %>
  </div>

  <div class="crayons-field">
    <%= f.label :slug, "Address (slug)", class: "crayons-field__label" %>
    <p class="crayons-field__description">
      Lowercase latin letters, digits, “-” and “_”. The voting lives at <code>/vote/&lt;slug&gt;</code>.
      Leave empty to derive it from the title.
    </p>
    <%= f.text_field :slug, class: "crayons-textfield", placeholder: "gra-roku-2026" %>
  </div>

  <label class="crayons-field crayons-field--checkbox">
    <%= f.check_box :top_level_path, class: "crayons-checkbox" %>
    <div>
      <div class="crayons-field__label">Also serve at the top level (<code>/&lt;slug&gt;</code>)</div>
      <p class="crayons-field__description">Like top-level pages. The slug must not be taken by a member, organization, page or podcast.</p>
    </div>
  </label>

  <div class="crayons-field">
    <%= f.label :description_markdown, "Intro (Markdown)", class: "crayons-field__label" %>
    <%= f.text_area :description_markdown, class: "crayons-textfield", rows: 5,
                                           placeholder: "Обираємо найкращі ігри року разом зі спільнотою…" %>
  </div>

  <div class="crayons-field">
    <%= f.label :banner_image, "Banner image (optional, wide)", class: "crayons-field__label" %>
    <% if @voting.banner_image.present? %>
      <img src="<%= @voting.banner_image.url %>" alt="" class="radius-default mb-2" style="max-width: 420px;">
      <label class="crayons-field crayons-field--checkbox">
        <%= f.check_box :remove_banner_image, class: "crayons-checkbox" %>
        <span class="crayons-field__label">Remove banner</span>
      </label>
    <% end %>
    <%= f.file_field :banner_image, accept: "image/*" %>
  </div>

  <div class="grid s:grid-cols-2 gap-4">
    <div class="crayons-field">
      <%= f.label :opens_at, "Opens at", class: "crayons-field__label" %>
      <%= f.datetime_local_field :opens_at, class: "crayons-textfield" %>
    </div>
    <div class="crayons-field">
      <%= f.label :closes_at, "Closes at", class: "crayons-field__label" %>
      <%= f.datetime_local_field :closes_at, class: "crayons-textfield" %>
    </div>
  </div>
  <p class="crayons-field__description -mt-4">Times are in the server time zone (<%= Time.zone.name %>). Empty means no limit.</p>

  <fieldset class="crayons-card crayons-card--secondary p-4 flex flex-col gap-4">
    <legend class="crayons-subtitle-2">Who can vote</legend>
    <p class="crayons-field__description">
      Always required: signed in, confirmed email, not suspended/spam/banished.
    </p>
    <div class="crayons-field">
      <%= f.label :min_user_score, "Minimum member score", class: "crayons-field__label" %>
      <p class="crayons-field__description">New members start at 0; flags and vomits push the score below 0. 0 = everyone except members with a negative score.</p>
      <%= f.number_field :min_user_score, class: "crayons-textfield", step: 1 %>
    </div>
    <label class="crayons-field crayons-field--checkbox">
      <%= f.check_box :require_account_before_start, class: "crayons-checkbox" %>
      <div>
        <div class="crayons-field__label">Only accounts created before the voting opens</div>
        <p class="crayons-field__description">Blocks fresh accounts registered just to vote. Needs “Opens at”.</p>
      </div>
    </label>
  </fieldset>

  <label class="crayons-field crayons-field--checkbox">
    <%= f.check_box :published, class: "crayons-checkbox" %>
    <div>
      <div class="crayons-field__label">Published</div>
      <p class="crayons-field__description">Unpublished votings are visible to admins only.</p>
    </div>
  </label>

  <div class="flex gap-2">
    <%= f.submit @voting.persisted? ? "Save" : "Create voting", class: "crayons-btn" %>
    <%= link_to "Cancel", @voting.persisted? ? admin_voting_path(@voting) : admin_votings_path, class: "crayons-btn crayons-btn--ghost" %>
  </div>
<% end %>
