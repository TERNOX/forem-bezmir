<header class="admin__header mb-4 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="fs-4xl fw-bold"><%= @voting.title %></h1>
    <p class="mt-1 flex flex-wrap items-center gap-2">
      <%= render "admin/votings/status_badge", voting: @voting %>
      <span class="color-base-60"><%= pluralize(@ballots_count, "ballot") %></span>
      <a href="<%= @voting.path %>" target="_blank" rel="noopener"><code><%= @voting.path %></code> ↗</a>
    </p>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= link_to "Results", results_admin_voting_path(@voting), class: "crayons-btn crayons-btn--secondary" %>
    <%= link_to "Settings", edit_admin_voting_path(@voting), class: "crayons-btn crayons-btn--secondary" %>
    <%= button_to "Copy voting", clone_admin_voting_path(@voting), method: :post, class: "crayons-btn crayons-btn--ghost",
                                                                  form: { data: { confirm: "Copy all nominations and nominees into a new draft voting?" } } %>
    <%= link_to "Add nomination", new_admin_voting_voting_category_path(@voting), class: "crayons-btn crayons-btn--branded" %>
  </div>
</header>

<% unless @igdb_configured %>
  <div class="crayons-notice crayons-notice--warning mb-4" role="alert">
    IGDB is not configured, so game search only covers games already in the catalog. Add the Twitch Client ID and
    Secret under <%= link_to "Config → IGDB (Votings)", admin_config_path %>.
  </div>
<% end %>

<% if @categories.empty? %>
  <div class="crayons-card p-6 text-center color-base-60">
    No nominations yet. <%= link_to "Add the first one", new_admin_voting_voting_category_path(@voting) %>.
  </div>
<% end %>

<% all_categories = VotingCategory.includes(:voting).where.not(id: nil).order(:voting_id, :position) %>

<% @categories.each_with_index do |category, index| %>
  <section id="category-<%= category.id %>" class="crayons-card p-4 mb-4">
    <div class="flex flex-wrap items-start justify-between gap-2 mb-3">
      <div>
        <h2 class="crayons-subtitle-1"><%= index + 1 %>. <%= category.title %></h2>
        <% if category.description.present? %>
          <p class="color-base-70 fs-s"><%= category.description %></p>
        <% end %>
        <p class="flex flex-wrap gap-1 mt-1">
          <span class="crayons-badge"><%= category.ranked? ? "Ranked: #{category.max_choices} places (#{(1..category.max_choices).map { |r| category.points_for(r) }.join('-')} pts)" : (category.single_choice? ? "One choice" : "Up to #{category.max_choices}") %></span>
          <span class="crayons-badge"><%= category.required? ? "Required" : "Optional" %></span>
          <span class="crayons-badge"><%= category.card_style == "artwork" ? "Wide artwork" : "Covers 2:3" %></span>
          <% if category.allow_other? %><span class="crayons-badge">“Other” answer</span><% end %>
        </p>
      </div>
      <div class="flex gap-1">
        <%= button_to "↑", move_admin_voting_voting_category_path(@voting, category, direction: "up"), method: :patch, class: "crayons-btn crayons-btn--ghost crayons-btn--s", title: "Move up", disabled: index.zero? %>
        <%= button_to "↓", move_admin_voting_voting_category_path(@voting, category, direction: "down"), method: :patch, class: "crayons-btn crayons-btn--ghost crayons-btn--s", title: "Move down", disabled: index == @categories.size - 1 %>
        <%= link_to "Edit", edit_admin_voting_voting_category_path(@voting, category), class: "crayons-btn crayons-btn--ghost crayons-btn--s" %>
        <%= link_to "Delete", admin_voting_voting_category_path(@voting, category), method: :delete,
                                                                                  data: { confirm: "Delete “#{category.title}” with its nominees and votes?" },
                                                                                  class: "crayons-btn crayons-btn--ghost crayons-btn--s color-accent-danger" %>
      </div>
    </div>

    <% if category.nominees.any? %>
      <ul class="voting-admin-nominees">
        <% category.nominees.each_with_index do |nominee, nominee_index| %>
          <li class="voting-admin-nominee">
            <% image_url = nominee.image_url_for(category.card_style) %>
            <div class="voting-admin-nominee__image voting-admin-nominee__image--<%= category.card_style %>">
              <% if image_url %>
                <img src="<%= image_url %>" alt="" loading="lazy">
              <% end %>
            </div>
            <div class="voting-admin-nominee__body">
              <strong class="fs-s"><%= nominee.display_title %></strong>
              <span class="fs-xs color-base-60">
                <%= nominee.game ? [nominee.game.release_year, nominee.game.platforms.first(3).join(", ").presence].compact.join(" · ") : "Custom card" %>
              </span>
              <% if nominee.link_url.present? %>
                <a href="<%= nominee.link_url %>" class="fs-xs" target="_blank" rel="noopener">link ↗</a>
              <% end %>
            </div>
            <div class="voting-admin-nominee__actions">
              <%= button_to "←", move_admin_voting_voting_category_voting_nominee_path(@voting, category, nominee, direction: "up"), method: :patch, class: "crayons-btn crayons-btn--ghost crayons-btn--xs", title: "Move earlier", disabled: nominee_index.zero? %>
              <%= button_to "→", move_admin_voting_voting_category_voting_nominee_path(@voting, category, nominee, direction: "down"), method: :patch, class: "crayons-btn crayons-btn--ghost crayons-btn--xs", title: "Move later", disabled: nominee_index == category.nominees.size - 1 %>
              <%= link_to "Edit", edit_admin_voting_voting_category_voting_nominee_path(@voting, category, nominee), class: "crayons-btn crayons-btn--ghost crayons-btn--xs" %>
              <%= link_to "✕", admin_voting_voting_category_voting_nominee_path(@voting, category, nominee), method: :delete,
                                                                                                         data: { confirm: "Remove “#{nominee.display_title}”?" },
                                                                                                         title: "Remove",
                                                                                                         class: "crayons-btn crayons-btn--ghost crayons-btn--xs" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="color-base-60 fs-s mb-3">No nominees yet.</p>
    <% end %>

    <div class="voting-admin-picker mt-3"
         data-controller="voting-nominee-picker"
         data-voting-nominee-picker-search-url-value="<%= search_admin_games_path(format: :json) %>"
         data-voting-nominee-picker-create-url-value="<%= admin_voting_voting_category_voting_nominees_path(@voting, category, format: :json) %>">
      <label class="crayons-field__label" for="picker-<%= category.id %>">Add a game</label>
      <input id="picker-<%= category.id %>" type="search" class="crayons-textfield" autocomplete="off"
             placeholder="Start typing a title, e.g. Hades II"
             data-voting-nominee-picker-target="input"
             data-action="input->voting-nominee-picker#search keydown.esc->voting-nominee-picker#clear">
      <p class="fs-xs color-base-60 mt-1" data-voting-nominee-picker-target="status"></p>
      <ul class="voting-admin-picker__results" data-voting-nominee-picker-target="results"></ul>
    </div>

    <details class="mt-3">
      <summary class="cursor-pointer fs-s fw-medium">Add many at once / custom card / copy from another nomination</summary>
      <div class="grid m:grid-cols-3 gap-4 mt-3">
        <%= form_with url: bulk_create_admin_voting_voting_category_voting_nominees_path(@voting, category), method: :post, local: true, class: "flex flex-col gap-2" do %>
          <label class="crayons-field__label" for="bulk-<%= category.id %>">Paste titles, one per line</label>
          <p class="crayons-field__description">Each line is matched in the catalog, then on IGDB. Start a line with “!” to add it as a custom card.</p>
          <textarea id="bulk-<%= category.id %>" name="titles" rows="6" class="crayons-textfield" placeholder="Hades II&#10;Hollow Knight: Silksong&#10;!Інше"></textarea>
          <button type="submit" class="crayons-btn crayons-btn--secondary">Add all</button>
        <% end %>

        <%= form_with model: VotingNominee.new, url: admin_voting_voting_category_voting_nominees_path(@voting, category), method: :post, local: true, multipart: true, class: "flex flex-col gap-2" do |nf| %>
          <span class="crayons-field__label">Custom card (news, device, anything)</span>
          <%= nf.text_field :title, class: "crayons-textfield", placeholder: "Title", required: true %>
          <%= nf.text_field :subtitle, class: "crayons-textfield", placeholder: "Subtitle (optional)" %>
          <%= nf.url_field :link_url, class: "crayons-textfield", placeholder: "https://… (optional)" %>
          <%= nf.file_field :image, accept: "image/*" %>
          <button type="submit" class="crayons-btn crayons-btn--secondary">Add card</button>
        <% end %>

        <%= form_with url: copy_nominees_admin_voting_voting_category_path(@voting, category), method: :post, local: true, class: "flex flex-col gap-2" do %>
          <label class="crayons-field__label" for="copy-<%= category.id %>">Copy nominees from</label>
          <p class="crayons-field__description">Adds the nominees that are not here yet.</p>
          <div class="crayons-select">
            <select id="copy-<%= category.id %>" name="source_category_id" class="crayons-select__native">
              <% all_categories.each do |other| %>
                <% next if other.id == category.id %>
                <option value="<%= other.id %>"><%= other.voting_id == @voting.id ? "" : "[#{other.voting.title}] " %><%= other.title %></option>
              <% end %>
            </select>
          </div>
          <button type="submit" class="crayons-btn crayons-btn--secondary">Copy</button>
        <% end %>
      </div>
    </details>
  </section>
<% end %>

<style>
  .voting-admin-nominees { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: var(--su-3); list-style: none; padding: 0; margin: 0; }
  .voting-admin-nominee { display: flex; flex-direction: column; gap: var(--su-1); border: 1px solid var(--base-10); border-radius: var(--radius); padding: var(--su-2); background: var(--card-bg); }
  .voting-admin-nominee__image { background: var(--base-10); border-radius: var(--radius); overflow: hidden; }
  .voting-admin-nominee__image--cover { aspect-ratio: 3 / 4; }
  .voting-admin-nominee__image--artwork { aspect-ratio: 16 / 9; }
  .voting-admin-nominee__image img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .voting-admin-nominee__body { display: flex; flex-direction: column; min-height: 3em; }
  .voting-admin-nominee__actions { display: flex; flex-wrap: wrap; gap: 2px; }
  .voting-admin-nominee__actions form { display: inline; }
  .voting-admin-picker__results { list-style: none; padding: 0; margin: var(--su-2) 0 0; display: grid; gap: var(--su-1); max-height: 420px; overflow-y: auto; }
  .voting-admin-picker__item { display: flex; align-items: center; gap: var(--su-3); padding: var(--su-2); border: 1px solid var(--base-10); border-radius: var(--radius); background: var(--card-bg); }
  .voting-admin-picker__item img, .voting-admin-picker__noimg { width: 40px; height: 54px; object-fit: cover; border-radius: 4px; background: var(--base-10); flex-shrink: 0; }
  .voting-admin-picker__meta { flex: 1; display: flex; flex-direction: column; }
</style>
