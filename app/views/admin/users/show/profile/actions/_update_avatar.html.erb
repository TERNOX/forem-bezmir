<div id="update-avatar">
  <%= form_with model: @user, url: update_avatar_admin_user_path(@user), method: :patch, local: true do |f| %>
    <div class="grid gap-4">
      <div>
        <% current_avatar_url = @user.profile_image&.url || @user.profile_image_url %>
        <p class="fs-s color-base-60"><%= t("views.admin.users.update_avatar.current") %></p>
        <% if current_avatar_url.present? %>
          <p class="fs-s break-all">
            <%= link_to current_avatar_url, current_avatar_url, class: "c-link", target: "_blank", rel: "noopener" %>
          </p>
        <% else %>
          <p class="fs-s color-base-60"><%= t("views.admin.users.update_avatar.none") %></p>
        <% end %>
      </div>
      <div class="crayons-field">
        <%= f.label :remote_profile_image_url, t("views.admin.users.update_avatar.new_url"), class: "c-label" %>
        <%= f.text_field :remote_profile_image_url, class: "crayons-textfield", placeholder: t("views.admin.users.update_avatar.placeholder") %>
        <p class="c-form__helper-text"><%= t("views.admin.users.update_avatar.helper") %></p>
      </div>
      <div class="flex justify-end gap-2">
        <%= f.submit t("views.admin.users.update_avatar.submit"), class: "c-btn c-btn--primary" %>
      </div>
    </div>
  <% end %>
</div>
