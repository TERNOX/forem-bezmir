<header class="admin__header mb-4 flex flex-wrap items-start justify-between gap-4">
  <div>
    <p class="color-base-60"><%= link_to "Game catalog", admin_games_path %></p>
    <h1 class="fs-4xl fw-bold"><%= @game.title %></h1>
    <% if @game.igdb_url.present? %>
      <a href="<%= @game.igdb_url %>" target="_blank" rel="noopener" class="fs-s">IGDB page ↗</a>
    <% end %>
  </div>
  <% if @game.igdb_id %>
    <div class="flex gap-2">
      <%= button_to "Refresh from IGDB", refresh_admin_game_path(@game), method: :post, class: "crayons-btn crayons-btn--secondary" %>
      <%= button_to "Re-download IGDB images", refresh_admin_game_path(@game, reset_images: "1"), method: :post, class: "crayons-btn crayons-btn--ghost",
                                                                                                  form: { data: { confirm: "Replace both pictures (including uploaded ones) with IGDB images?" } } %>
    </div>
  <% end %>
</header>

<div class="crayons-card p-6">
  <%= form_for [:admin, @game], html: { class: "flex flex-col gap-6", multipart: true } do |f| %>
    <% if @game.errors.any? %>
      <div class="crayons-notice crayons-notice--danger" role="alert"><%= @game.errors.full_messages.to_sentence %></div>
    <% end %>
    <div class="crayons-field">
      <%= f.label :title, class: "crayons-field__label" %>
      <%= f.text_field :title, class: "crayons-textfield", required: true %>
    </div>
    <div class="crayons-field">
      <%= f.label :release_year, class: "crayons-field__label" %>
      <%= f.number_field :release_year, class: "crayons-textfield" %>
    </div>
    <div class="grid s:grid-cols-2 gap-6">
      <div class="crayons-field">
        <%= f.label :cover_image, "Cover (vertical 2:3)", class: "crayons-field__label" %>
        <% if @game.cover_url %>
          <img src="<%= @game.cover_url %>" alt="" style="width: 160px; border-radius: 6px;" class="mb-2">
        <% end %>
        <%= f.file_field :cover_image, accept: "image/*" %>
      </div>
      <div class="crayons-field">
        <%= f.label :artwork_image, "Artwork (wide 16:9)", class: "crayons-field__label" %>
        <% if @game.artwork_url %>
          <img src="<%= @game.artwork_url %>" alt="" style="width: 280px; border-radius: 6px;" class="mb-2">
        <% end %>
        <%= f.file_field :artwork_image, accept: "image/*" %>
      </div>
    </div>
    <div class="flex gap-2">
      <%= f.submit "Save", class: "crayons-btn" %>
      <%= link_to "Back", admin_games_path, class: "crayons-btn crayons-btn--ghost" %>
    </div>
  <% end %>
</div>
