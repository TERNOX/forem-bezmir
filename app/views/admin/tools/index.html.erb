<div class="crayons-card p-6 mb-6">
  <h2 class="crayons-subtitle-1 mb-4">General Purpose URL Purge</h2>
  <p class="mb-2">For a page that should 404. This will purge the page via Fastly.</p>
  <p class="mb-6">Use the full path (<%= app_url("xyz") %>) or the relative path: (/xyz)</p>
  <%= form_tag bust_cache_admin_tools_path do %>
    <div class="crayons-field">
      <%= label_tag :dead_link, "Link:", class: "crayons-field__label" %>
      <%= text_field_tag :dead_link, nil, placeholder: "/xyz", class: "crayons-textfield" %>
      <%= submit_tag :"Clear Cache", class: "crayons-btn mr-auto" %>
    </div>
  <% end %>
</div>

<div class="crayons-card p-6 mb-6">
  <h2 class="crayons-subtitle-1 mb-4">Bust Cache For Specific Content</h2>
  <p class="mb-6">This clears both the Rails cache & the Fastly cache.</p>
  <%= form_tag bust_cache_admin_tools_path do %>
    <div class="crayons-field">
      <%= label_tag :bust_article, "Article ID:", class: "crayons-field__label" %>
      <%= text_field_tag :bust_article, nil, placeholder: "12345", class: "crayons-textfield" %>
      <%= submit_tag :"Clear Article Cache", class: "crayons-btn mr-auto" %>
    </div>
  <% end %>
  <%= form_tag bust_cache_admin_tools_path do %>
    <div class="crayons-field mt-6">
      <%= label_tag :bust_user, "User ID:", class: "crayons-field__label" %>
      <%= text_field_tag :bust_user, nil, placeholder: "12345", class: "crayons-textfield" %>
      <%= submit_tag :"Clear User Cache", class: "crayons-btn mr-auto" %>
    </div>
  <% end %>
</div>

<div class="crayons-card p-6 mb-6">
  <h2 class="crayons-subtitle-1 mb-4"><%= t("views.admin.tools.reputation.heading") %></h2>
  <p class="mb-6"><%= t("views.admin.tools.reputation.description_html") %></p>
  <%= form_tag recalculate_reputation_admin_tools_path do %>
    <%= submit_tag t("views.admin.tools.reputation.submit"), class: "crayons-btn" %>
  <% end %>
</div>

<div class="crayons-card p-6 mb-6">
  <h2 class="crayons-subtitle-1 mb-4"><%= t("views.admin.tools.resave_published.heading") %></h2>
  <p class="mb-6"><%= t("views.admin.tools.resave_published.description_html") %></p>
  <%= form_with url: resave_published_articles_admin_tools_path, method: :post, local: true do %>
    <%= submit_tag t("views.admin.tools.resave_published.submit"), class: "crayons-btn" %>
  <% end %>
</div>

<div class="crayons-card p-6 mb-6">
  <h2 class="crayons-subtitle-1 mb-4"><%= t("views.admin.tools.monthly_top_users.heading") %></h2>
  <p class="mb-6"><%= t("views.admin.tools.monthly_top_users.description_html") %></p>

  <%= form_with url: monthly_top_users_awards_admin_tools_path, method: :post, local: true do %>
    <div class="grid gap-6 md:grid-cols-2">
      <div class="crayons-field">
        <%= label_tag "monthly_top_users_badge_slug", t("views.admin.tools.monthly_top_users.form.badge_slug"), class: "crayons-field__label" %>
        <%= text_field_tag "monthly_top_users[badge_slug]", @monthly_top_users_settings[:badge_slug], class: "crayons-textfield" %>
        <p class="crayons-field__description"><%= t("views.admin.tools.monthly_top_users.form.badge_slug_help") %></p>
      </div>

      <div class="crayons-field">
        <%= label_tag "monthly_top_users_award_day", t("views.admin.tools.monthly_top_users.form.award_day"), class: "crayons-field__label" %>
        <%= number_field_tag "monthly_top_users[award_day]", @monthly_top_users_settings[:award_day], class: "crayons-textfield", min: 1, max: 31 %>
        <p class="crayons-field__description"><%= t("views.admin.tools.monthly_top_users.form.award_day_help") %></p>
      </div>

      <div class="crayons-field">
        <%= label_tag "monthly_top_users_award_time", t("views.admin.tools.monthly_top_users.form.award_time"), class: "crayons-field__label" %>
        <%= time_field_tag "monthly_top_users[award_time]", @monthly_top_users_settings[:award_time], class: "crayons-textfield" %>
        <p class="crayons-field__description"><%= t("views.admin.tools.monthly_top_users.form.award_time_help") %></p>
      </div>

      <div class="crayons-field md:col-span-2">
        <%= label_tag "monthly_top_users_message_template", t("views.admin.tools.monthly_top_users.form.message_template"), class: "crayons-field__label" %>
        <%= text_area_tag "monthly_top_users[message_template]", @monthly_top_users_settings[:message_template], class: "crayons-textfield", rows: 3 %>
        <p class="crayons-field__description"><%= t("views.admin.tools.monthly_top_users.form.message_template_help_html").html_safe %></p>
      </div>
    </div>

    <div class="flex items-center mt-6">
      <%= submit_tag t("views.admin.tools.monthly_top_users.form.save"), class: "crayons-btn" %>
      <% if @monthly_top_users_next_run_at.present? %>
        <span class="ml-4 color-base-60 text-sm"><%= t("views.admin.tools.monthly_top_users.next_run", timestamp: l(@monthly_top_users_next_run_at, format: :long)) %></span>
      <% end %>
    </div>
  <% end %>

  <div class="crayons-callout crayons-callout--info mt-6">
    <h4 class="crayons-subtitle-3 mb-2"><%= t("views.admin.tools.monthly_top_users.placeholders.heading") %></h4>
    <ul class="pl-6 list-disc">
      <% t("views.admin.tools.monthly_top_users.placeholders.items").each do |item| %>
        <li class="mb-1"><%= item.respond_to?(:html_safe) ? item.html_safe : item %></li>
      <% end %>
    </ul>
  </div>

  <section class="mt-6">
    <h4 class="crayons-subtitle-3 mb-2"><%= t("views.admin.tools.monthly_top_users.status.heading") %></h4>

    <% if @monthly_top_users_status.present? && @monthly_top_users_status[:at].present? %>
      <p class="mb-2"><%= t("views.admin.tools.monthly_top_users.status.last_run", period: @monthly_top_users_status[:period], timestamp: l(@monthly_top_users_status[:at], format: :long)) %></p>
      <% if @monthly_top_users_status[:usernames].present? %>
        <p class="mb-2"><%= t("views.admin.tools.monthly_top_users.status.recipients_html", usernames: @monthly_top_users_status[:usernames].map { |username| content_tag(:code, username) }.to_sentence.html_safe) %></p>
      <% end %>
      <% if @monthly_top_users_status[:message].present? %>
        <p class="mb-0"><%= t("views.admin.tools.monthly_top_users.status.message_html", message: content_tag(:code, @monthly_top_users_status[:message])) %></p>
      <% end %>
    <% else %>
      <p class="color-base-70 mb-0"><%= t("views.admin.tools.monthly_top_users.status.empty") %></p>
    <% end %>
  </section>
</div>

<div class="crayons-card p-6 mb-6">
  <h2 class="crayons-subtitle-1 mb-4"><%= t("views.admin.tools.top_seven.heading") %></h2>
  <p class="mb-6"><%= t("views.admin.tools.top_seven.description_html") %></p>

  <% if @top_seven_selections.any? %>
    <% @top_seven_selections.each do |selection| %>
      <section class="mb-6">
        <h3 class="crayons-subtitle-2 mb-2"><%= selection.week_label %></h3>

        <ol class="pl-6 list-decimal mb-4">
          <% selection.article_ids.each do |article_id| %>
            <% article = @top_seven_articles_by_id[article_id] %>
            <% next unless article %>

            <li class="mb-1">
              <%= link_to article.title, article.path, class: "c-link" %>
            </li>
          <% end %>
        </ol>

        <% urls = selection.article_ids.filter_map do |article_id|
             article = @top_seven_articles_by_id[article_id]
             article ? app_url(article.path) : nil
           end.join("\n") %>
        <%= text_area_tag "weekly_top_seven_#{selection.week_of}", urls, class: "crayons-textfield w-100", rows: 4, readonly: true %>
      </section>
    <% end %>
  <% else %>
    <p class="color-base-70"><%= t("views.admin.tools.top_seven.empty_state") %></p>
  <% end %>

  <hr class="my-6" />

  <section>
    <h3 class="crayons-subtitle-2 mb-2"><%= t("views.admin.tools.top_articles_digest.heading") %></h3>
    <p class="mb-6"><%= t("views.admin.tools.top_articles_digest.description_html") %></p>

    <div class="crayons-card crayons-card--secondary p-4 mb-6">
      <h4 class="crayons-subtitle-3 mb-2"><%= t("views.admin.tools.top_articles_digest.status.heading") %></h4>
      <p class="mb-4"><%= t("views.admin.tools.top_articles_digest.status.schedule_summary") %></p>
      <dl class="grid gap-4">
        <div>
          <dt class="crayons-subtitle-4 color-base-70"><%= t("views.admin.tools.top_articles_digest.status.last_run") %></dt>
          <dd>
            <% if @top_articles_digest_status[:at].present? %>
              <span><%= l(@top_articles_digest_status[:at], format: :long) %></span>
              <% if @top_articles_digest_status[:status].present? %>
                <span class="ml-2">
                  <%= t("views.admin.tools.top_articles_digest.status.states.#{@top_articles_digest_status[:status]}", default: @top_articles_digest_status[:status].to_s.humanize) %>
                </span>
              <% end %>
            <% else %>
              <span class="color-base-70"><%= t("views.admin.tools.top_articles_digest.status.last_run_empty") %></span>
            <% end %>
          </dd>
          <% if @top_articles_digest_status[:message].present? %>
            <dd class="color-error mt-1"><%= @top_articles_digest_status[:message] %></dd>
          <% end %>
        </div>
        <div>
          <dt class="crayons-subtitle-4 color-base-70"><%= t("views.admin.tools.top_articles_digest.status.next_run") %></dt>
          <dd>
            <% if @top_articles_digest_next_run_at.present? %>
              <span><%= l(@top_articles_digest_next_run_at, format: :long) %></span>
            <% else %>
              <span class="color-base-70"><%= t("views.admin.tools.top_articles_digest.status.next_run_empty") %></span>
            <% end %>
          </dd>
        </div>
      </dl>
    </div>

    <%= form_with url: admin_tools_path, method: :post, local: true do %>
      <div class="grid gap-6">
        <div class="crayons-field">
          <%= label_tag "top_articles_digest_bot_api_key", t("views.admin.tools.top_articles_digest.form.bot_api_key"), class: "crayons-field__label" %>
          <%= text_field_tag "top_articles_digest[bot_api_key]", @top_articles_digest_settings[:bot_api_key], class: "crayons-textfield" %>
          <p class="crayons-field__description"><%= t("views.admin.tools.top_articles_digest.form.bot_api_key_help") %></p>
        </div>

        <div class="crayons-field">
          <%= label_tag "top_articles_digest_title_template", t("views.admin.tools.top_articles_digest.form.title_template"), class: "crayons-field__label" %>
          <%= text_field_tag "top_articles_digest[title_template]", @top_articles_digest_settings[:title_template], class: "crayons-textfield" %>
          <p class="crayons-field__description"><%= t("views.admin.tools.top_articles_digest.form.title_template_help_html").html_safe %></p>
        </div>

        <div class="crayons-field">
          <%= label_tag "top_articles_digest_tags", t("views.admin.tools.top_articles_digest.form.tags"), class: "crayons-field__label" %>
          <%= text_field_tag "top_articles_digest[tags]", @top_articles_digest_settings[:tags], class: "crayons-textfield" %>
          <p class="crayons-field__description"><%= t("views.admin.tools.top_articles_digest.form.tags_help") %></p>
        </div>

        <div class="crayons-field">
          <%= label_tag "top_articles_digest_image_url", t("views.admin.tools.top_articles_digest.form.image_url"), class: "crayons-field__label" %>
          <%= text_field_tag "top_articles_digest[image_url]", @top_articles_digest_settings[:image_url], class: "crayons-textfield" %>
        </div>

        <div class="crayons-field">
          <%= label_tag "top_articles_digest_organization_id", t("views.admin.tools.top_articles_digest.form.organization_id"), class: "crayons-field__label" %>
          <%= number_field_tag "top_articles_digest[organization_id]", @top_articles_digest_settings[:organization_id], class: "crayons-textfield", min: 1 %>
          <p class="crayons-field__description"><%= t("views.admin.tools.top_articles_digest.form.organization_help") %></p>
        </div>

        <div class="crayons-field">
          <%= label_tag "top_articles_digest_excluded_organization_ids", t("views.admin.tools.top_articles_digest.form.excluded_organization_ids"), class: "crayons-field__label" %>
          <%= text_field_tag "top_articles_digest[excluded_organization_ids]", @top_articles_digest_settings[:excluded_organization_ids], class: "crayons-textfield", placeholder: "1,2" %>
          <p class="crayons-field__description"><%= t("views.admin.tools.top_articles_digest.form.excluded_organization_ids_help") %></p>
        </div>

        <div class="crayons-field">
          <%= label_tag "top_articles_digest_intro_markdown", t("views.admin.tools.top_articles_digest.form.intro_markdown"), class: "crayons-field__label" %>
          <%= text_area_tag "top_articles_digest[intro_markdown]", @top_articles_digest_settings[:intro_markdown], class: "crayons-textfield", rows: 4 %>
        </div>

        <div class="crayons-field">
          <%= label_tag "top_articles_digest_frequency", t("views.admin.tools.top_articles_digest.form.frequency"), class: "crayons-field__label" %>
          <%= select_tag "top_articles_digest[frequency]",
                        options_for_select(
                          %w[daily weekly monthly].map { |value| [t("views.admin.tools.top_articles_digest.form.frequency_options.#{value}"), value] },
                          @top_articles_digest_settings[:frequency],
                        ),
                        class: "crayons-select" %>
        </div>

        <div class="crayons-field">
          <%= label_tag "top_articles_digest_article_limit", t("views.admin.tools.top_articles_digest.form.article_limit"), class: "crayons-field__label" %>
          <%= number_field_tag "top_articles_digest[article_limit]", @top_articles_digest_settings[:article_limit], class: "crayons-textfield", min: 1 %>
        </div>

        <div class="crayons-field">
          <%= label_tag "top_articles_digest_minimum_score", t("views.admin.tools.top_articles_digest.form.minimum_score"), class: "crayons-field__label" %>
          <%= number_field_tag "top_articles_digest[minimum_score]", @top_articles_digest_settings[:minimum_score], class: "crayons-textfield", min: 0 %>
          <p class="crayons-field__description"><%= t("views.admin.tools.top_articles_digest.form.minimum_score_help") %></p>
        </div>

        <div class="crayons-field">
          <%= label_tag "top_articles_digest_excluded_tags", t("views.admin.tools.top_articles_digest.form.excluded_tags"), class: "crayons-field__label" %>
          <%= text_field_tag "top_articles_digest[excluded_tags]", @top_articles_digest_settings[:excluded_tags], class: "crayons-textfield" %>
          <p class="crayons-field__description"><%= t("views.admin.tools.top_articles_digest.form.excluded_tags_help") %></p>
        </div>

        <div class="crayons-field">
          <%= label_tag "top_articles_digest_badge_slug", t("views.admin.tools.top_articles_digest.form.badge_slug"), class: "crayons-field__label" %>
          <%= text_field_tag "top_articles_digest[badge_slug]", @top_articles_digest_settings[:badge_slug], class: "crayons-textfield" %>
        </div>

        <div class="crayons-field">
          <%= label_tag "top_articles_digest_next_run_hour", t("views.admin.tools.top_articles_digest.form.next_run_hour"), class: "crayons-field__label" %>
          <% hour_options = (0..23).map { |hour| [format("%02d:00", hour), hour.to_s] } %>
          <%= select_tag "top_articles_digest[next_run_hour]",
                        options_for_select(
                          [[t("views.admin.tools.top_articles_digest.form.next_run_hour_placeholder"), ""]] + hour_options,
                          @top_articles_digest_settings[:next_run_hour]&.to_s,
                        ),
                        class: "crayons-select" %>
          <p class="crayons-field__description"><%= t("views.admin.tools.top_articles_digest.form.next_run_hour_help") %></p>
        </div>

      </div>

      <div class="flex items-center mt-6">
        <%= submit_tag t("views.admin.tools.top_articles_digest.form.save"), class: "crayons-btn" %>
      </div>
    <% end %>

    <div class="crayons-callout crayons-callout--info mt-6">
      <h4 class="crayons-subtitle-3 mb-2"><%= t("views.admin.tools.top_articles_digest.placeholders.heading") %></h4>
      <ul class="pl-6 list-disc">
        <% t("views.admin.tools.top_articles_digest.placeholders.items").each do |item| %>
          <li class="mb-1"><%= item.respond_to?(:html_safe) ? item.html_safe : item %></li>
        <% end %>
      </ul>
    </div>

    <section class="mt-6">
      <h4 class="crayons-subtitle-3 mb-2"><%= t("views.admin.tools.top_articles_digest.preview.heading") %></h4>

      <%= form_with url: admin_tools_path, method: :get, local: true, class: "grid gap-4 md:grid-cols-2 mb-4" do %>
        <div class="crayons-field md:col-span-2">
          <span class="crayons-field__label"><%= t("views.admin.tools.top_articles_digest.preview.mode_label") %></span>
          <div class="flex flex-col gap-2 md:flex-row">
            <label class="flex items-center gap-2">
              <%= radio_button_tag :digest_preview_mode, "settings", @digest_preview_mode != "custom", class: "crayons-radio" %>
              <span><%= t("views.admin.tools.top_articles_digest.preview.mode_options.settings") %></span>
            </label>
            <label class="flex items-center gap-2">
              <%= radio_button_tag :digest_preview_mode, "custom", @digest_preview_mode == "custom", class: "crayons-radio" %>
              <span><%= t("views.admin.tools.top_articles_digest.preview.mode_options.custom") %></span>
            </label>
          </div>
          <p class="crayons-field__description"><%= t("views.admin.tools.top_articles_digest.preview.mode_help") %></p>
        </div>

        <div class="crayons-field">
          <%= label_tag "digest_preview_start_date", t("views.admin.tools.top_articles_digest.preview.start_date"), class: "crayons-field__label" %>
          <%= date_field_tag "digest_preview[start_date]", @digest_preview_form_params[:start_date], class: "crayons-textfield" %>
        </div>

        <div class="crayons-field">
          <%= label_tag "digest_preview_end_date", t("views.admin.tools.top_articles_digest.preview.end_date"), class: "crayons-field__label" %>
          <%= date_field_tag "digest_preview[end_date]", @digest_preview_form_params[:end_date], class: "crayons-textfield" %>
        </div>

        <div class="md:col-span-2">
          <%= submit_tag t("views.admin.tools.top_articles_digest.preview.update"), class: "crayons-btn" %>
        </div>
      <% end %>

      <div class="flex flex-wrap gap-4 mb-4">
        <%= form_with url: top_articles_digest_test_publish_admin_tools_path, method: :post, local: true do %>
          <%= hidden_field_tag :digest_preview_mode, @digest_preview_mode %>
          <%= hidden_field_tag "digest_preview[start_date]", @digest_preview_form_params[:start_date] %>
          <%= hidden_field_tag "digest_preview[end_date]", @digest_preview_form_params[:end_date] %>
          <%= submit_tag t("views.admin.tools.top_articles_digest.preview.test_publish.button"), class: "crayons-btn" %>
        <% end %>

        <%= form_with url: top_articles_digest_test_badges_admin_tools_path, method: :post, local: true do %>
          <%= hidden_field_tag :digest_preview_mode, @digest_preview_mode %>
          <%= hidden_field_tag "digest_preview[start_date]", @digest_preview_form_params[:start_date] %>
          <%= hidden_field_tag "digest_preview[end_date]", @digest_preview_form_params[:end_date] %>
          <%= submit_tag t("views.admin.tools.top_articles_digest.preview.test_badges.button"), class: "crayons-btn" %>
        <% end %>
      </div>

      <% if @top_articles_digest_preview[:available?] && @top_articles_digest_preview[:articles].present? %>
        <p class="mb-4">
          <%= t("views.admin.tools.top_articles_digest.preview.summary",
                range: "#{l(@top_articles_digest_preview[:period_start], format: :long)} – #{l(@top_articles_digest_preview[:period_end], format: :long)}",
                count: @top_articles_digest_preview[:articles].size) %>
        </p>

        <ol class="pl-6 list-decimal mb-4">
          <% @top_articles_digest_preview[:articles].each do |article| %>
            <li class="mb-1">
              <%= link_to article.title, article.path, class: "c-link" %>
            </li>
          <% end %>
        </ol>

        <% embed_text = @top_articles_digest_preview[:embed_urls].join("\n\n") %>
        <% preview_body = if @top_articles_digest_preview[:intro].present?
                            [@top_articles_digest_preview[:intro].strip, embed_text].compact_blank.join("\n\n")
                          else
                            embed_text
                          end %>
        <%= text_area_tag "top_articles_digest_preview_body",
                          preview_body,
                          class: "crayons-textfield w-100",
                          rows: 10,
                          readonly: true %>
      <% else %>
        <p class="color-base-70"><%= t("views.admin.tools.top_articles_digest.preview.empty_state") %></p>
      <% end %>
    </section>
  </section>
</div>

<%= render "admin/shared/image_uploader" %>
