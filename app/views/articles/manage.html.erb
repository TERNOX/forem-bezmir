<% title t("views.manager.meta.title", title: @article.title) %>
<main id="main-content" class="manage-page-with-sidebar">
  <!-- Sidebar Navigation -->
  <aside class="manage-sidebar crayons-card" id="manage-sidebar">
    <nav class="manage-sidebar-nav">
      <h3 class="manage-sidebar-title">Розділи</h3>
        <ul class="manage-sidebar-list">
        <li><a href="#section-overview" class="manage-sidebar-link" data-section="section-overview">Огляд</a></li>
        <li><a href="#section-stats" class="manage-sidebar-link" data-section="section-stats">Статистика</a></li>
        <li><a href="#section-edit" class="manage-sidebar-link" data-section="section-edit">Редагувати публікацію</a></li>
        <li><a href="#section-pin" class="manage-sidebar-link" data-section="section-pin">Закріпити у профілі</a></li>
        <li><a href="#section-discussion" class="manage-sidebar-link" data-section="section-discussion">Закрити коментарі</a></li>
        <li><a href="#section-delete" class="manage-sidebar-link" data-section="section-delete">Видалити публікацію</a></li>
        <li><a href="#section-tips" class="manage-sidebar-link" data-section="section-tips">Поради</a></li>
      </ul>
    </nav>
  </aside>

  <!-- Main Content -->
  <div class="manage-main-content">
    <nav class="mb-4">
      <a href="/dashboard" class="crayons-link"><%= t("views.manager.nav.dashboard") %></a><%= t("views.manager.nav.text") %>
    </nav>

    <% if flash[:error] %>
      <div class="crayons-notice crayons-notice--danger mb-4" role="alert">
        <%= t("views.manager.error.pins", error: flash[:pins_error]) %>
      </div>
    <% end %>
    
    <% if flash[:success] %>
      <div class="crayons-notice crayons-notice--success mb-4" role="alert">
        <%= flash[:success] %>
      </div>
    <% end %>

    <!-- Post Overview -->
    <div class="crayons-card p-6 mb-4" id="section-overview">
      <h2 class="crayons-title mb-4">Огляд публікації</h2>
      
      <div class="mb-4">
        <% if @article.organization_id %>
          <span class="crayons-tag"><%= @article.organization&.name %></span>
        <% end %>
        <% if @article.collection_id %>
          <span class="crayons-tag">Серія: <%= @article.series %></span>
        <% end %>
      </div>

      <h3 class="mb-3 fs-xl"><a href="<%= @article.current_state_path %>" class="crayons-link"><%= @article.title %></a></h3>
      
      <% if @article.published %>
        <div class="color-base-60 mb-3">
          Опубліковано <%= tag.time(@article.readable_publish_date, datetime: @article.published_timestamp) %>
          <% if @article.edited? %>
            · Відредаговано <%= tag.time(@article.readable_edit_date, datetime: @article.edited_at.utc.iso8601) %>
          <% end %>
        </div>

        <% if @article.cached_tag_list_array.any? %>
          <div class="mb-4">
            <% @article.cached_tag_list_array.each do |tag| %>
              <a href="/t/<%= tag %>" class="crayons-tag"><span class="crayons-tag__prefix">#</span><%= tag %></a>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="crayons-notice crayons-notice--warning mb-3">
          <strong>Чернетка</strong> — Ця публікація ще не опублікована.
        </div>
      <% end %>

      <% if @organization && @user.org_admin?(@organization) %>
        <div class="crayons-card p-4 mt-4" style="background: var(--card-secondary-bg);">
          <h4 class="mb-2 fw-bold">Адмін організації: змінити автора</h4>
          <%= form_for(@article) do |f| %>
            <%= f.hidden_field :from_dashboard, value: 1 %>
            <input type="hidden" name="destination" value="/dashboard/organization/<%= @organization.id %>" />
            <div class="flex items-center gap-3">
              <label class="mb-0">Автор:</label>
              <%= f.select(:user_id, options_for_select(@organization.users.pluck(:name, :id), @article.user_id), {}, class: "crayons-select") %>
              <%= f.submit "Оновити автора", class: "crayons-btn crayons-btn--secondary" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Statistics -->
    <% if @article.published %>
      <div class="crayons-card p-6 mb-4" id="section-stats">
        <div class="flex items-center justify-between mb-4">
          <h2 class="crayons-title mb-0">Статистика</h2>
          <a href="<%= @article.path %>/stats" data-no-instant class="crayons-btn crayons-btn--outlined">Переглянути детальну статистику</a>
        </div>
        
        <div class="grid gap-4" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
          <div class="crayons-card p-4" style="background: var(--card-secondary-bg);">
            <div class="color-base-60 fs-s mb-1">Перегляди сторінки</div>
            <div class="fs-3xl fw-bold"><%= number_with_delimiter(@article.page_views_count) %></div>
          </div>
          
          <div class="crayons-card p-4" style="background: var(--card-secondary-bg);">
            <div class="color-base-60 fs-s mb-1">Реакції</div>
            <div class="fs-3xl fw-bold"><%= number_with_delimiter(@article.public_reactions_count) %></div>
          </div>
          
          <div class="crayons-card p-4" style="background: var(--card-secondary-bg);">
            <div class="color-base-60 fs-s mb-1">Коментарі</div>
            <div class="fs-3xl fw-bold"><%= number_with_delimiter(@article.comments_count) %></div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Edit Post -->
    <div class="crayons-card p-6 mb-4" id="section-edit">
      <h2 class="crayons-title mb-2">Редагувати публікацію</h2>
      <p class="color-base-70 mb-4">
        Внесіть зміни до вмісту, заголовка, тегів або обкладинки вашої публікації.
      </p>
      <a href="<%= @article.path %>/edit" class="crayons-btn">Редагувати</a>
    </div>

    <!-- Pin to Profile -->
    <div class="crayons-card p-6 mb-4" id="section-pin">
      <h2 class="crayons-title mb-2">Закріпити у профілі</h2>
      <p class="color-base-70 mb-4">
        Закріплена публікація відображатиметься у верхній частині вашого профілю. Ви можете закріпити до 5 публікацій, щоб показати свої найкращі роботи.
      </p>
      <% if @article.profile_pins.any? %>
        <%= form_for(@article.profile_pins.first, html: { class: "mb-3" }) do |f| %>
          <button type="submit" class="crayons-btn crayons-btn--outlined" style="width: auto;">
            Відкріпити з профілю
          </button>
        <% end %>
        <p class="color-base-60 fs-s">
          Ця публікація наразі закріплена у вашому профілі.
        </p>
      <% else %>
        <%= form_for(ProfilePin.new) do |f| %>
          <%= f.hidden_field :pinnable_id, value: @article.id %>
          <button type="submit" class="crayons-btn" style="width: auto;">
            Закріпити у профілі
          </button>
        <% end %>
      <% end %>
    </div>

    <!-- Discussion Lock -->
    <div class="crayons-card p-6 mb-4" id="section-discussion">
      <h2 class="crayons-title mb-2">Закрити коментарі</h2>
      <p class="color-base-70 mb-4">
        Закриття коментарів не дозволяє залишати нові повідомлення. Існуючі коментарі залишаться видимими. Це зручно, якщо ви хочете завершити обговорення під статтею.
      </p>
      <% if @discussion_lock %>
        <a href="<%= @article.path %>/discussion_unlock_confirm" data-no-instant class="crayons-btn crayons-btn--outlined">
          <%= crayons_icon_tag("unlock", class: "mr-1") %>
          Відкрити коментарі
        </a>
        <p class="color-base-60 mt-2 fs-s">
          <%= crayons_icon_tag("lock", class: "mr-1") %>
          Коментарі наразі закриті. Нові залишити не можна.
        </p>
      <% else %>
        <a href="<%= @article.path %>/discussion_lock_confirm" data-no-instant class="crayons-btn">
          <%= crayons_icon_tag("lock", class: "mr-1") %>
          Закрити коментарі
        </a>
      <% end %>
    </div>


    <!-- Tips for Promotion -->
    <div class="crayons-card p-6" id="section-tips" style="margin-bottom: 140px">
      <h2 class="crayons-title mb-3"><%= t("views.manager.tips.heading") %></h2>
      <ol class="list-decimal ml-6">
        <li class="mb-3 color-base-80">
          <%= t("views.manager.tips.text_1") %>
        </li>
        <li class="mb-3 color-base-80">
          <%= t("views.manager.tips.text_2_html") %>
        </li>
        <li class="mb-3 color-base-80">
          <%= t("views.manager.tips.text_3") %>
        </li>
      </ol>
    </div>
  </div>
</main>
