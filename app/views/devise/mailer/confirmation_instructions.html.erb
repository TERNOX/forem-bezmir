<% if @user.creator? %>
  <%= render partial: "creator_confirmation_instructions", locals: { url: confirmation_url(@resource, confirmation_token: @token) } %>
<% else %>
  <p>Вітаємо? <%= " #{@name}" unless @name.include?("http") %>!</p>

  <p>Ви можете підтвердити електронну адресу свого акаунту за посиланням нижче.:</p>

  <p><%= link_to "Підтвердити мій акаунт", confirmation_url(@resource, confirmation_token: @token) %></p>
<% end %>
