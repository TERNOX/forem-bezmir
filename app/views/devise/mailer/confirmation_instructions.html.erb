<% if @user.creator? %>
  <%= render partial: "creator_confirmation_instructions", locals: { url: confirmation_url(@resource, confirmation_token: @token, host: @subforem_domain) } %>
<% else %>
  <p>Вітаємо<%= " #{@name}" unless @name.include?("http") %>!</p>

  <p>Ви можете підтвердити свою пошту за посиланням нижче:</p>

  <p><%= link_to "Підвердити мій акаунт", confirmation_url(@resource, confirmation_token: @token, host: @subforem_domain) %></p>
<% end %>
