<!-- Forem Event Show Page -->
<% content_for :title, @event.title %>
<%
  has_stream = @event.primary_stream_url.present?
  cover_image = @event.data&.dig('cover_image_url').presence
  external_url = @event.data&.dig('external_url').presence
  external_label = @event.data&.dig('external_label').presence || t("views.events.show.visit")
  safe_external = external_url.to_s.start_with?("http://", "https://", "/") ? external_url : nil

  # organizers / social_links are stored as multiline text in `data`, one entry
  # per line in the form "Label | https://url" (the URL part is optional).
  parse_links = lambda do |raw|
    raw.to_s.lines.map(&:strip).reject(&:blank?).map do |line|
      label, url = line.split("|", 2).map(&:strip)
      { label: label, url: (url if url.to_s.start_with?("http://", "https://", "/")) }
    end.reject { |entry| entry[:label].blank? }
  end
  organizers = parse_links.call(@event.data&.dig('organizers'))
  social_links = parse_links.call(@event.data&.dig('social_links'))
%>
<%= content_for :page_meta do %>
  <link rel="canonical" href="<%= app_url(event_path(@event.event_name_slug, @event.event_variation_slug)) %>" />
  <meta name="description" content="<%= @event.description %>">
  <meta property="og:title" content="<%= @event.title %>" />
  <meta property="og:description" content="<%= @event.description %>" />
  <meta property="og:url" content="<%= app_url(event_path(@event.event_name_slug, @event.event_variation_slug)) %>" />
  <meta property="og:type" content="event" />
  <meta property="og:image" content="<%= @event.social_image_url %>" />
  <meta name="twitter:image:src" content="<%= @event.social_image_url %>">
  <meta name="twitter:card" content="summary_large_image">
<% end %>
<div class="container crayons-layout event-show-layout">
    <% unless @event.published? %>
      <div class="crayons-notice crayons-notice--warning mb-8 p-4 text-center">
        <%= t("views.events.show.unpublished_html").html_safe %>
        <a href="<%= edit_admin_event_path(@event) %>" class="c-link c-link--branded ml-2"><%= t("views.events.show.edit") %></a>
      </div>
    <% end %>

    <div class="event-header">
        <h1><%= @event.title %></h1>
        <% if @event.start_time <= Time.current && @event.end_time >= Time.current %>
          <span class="live-indicator"><%= t("views.events.show.live") %></span>
        <% end %>

        <% if @event.start_time > Time.current %>
          <div class="event-signup-container ml-auto">
            <% if current_user %>
              <% if current_user.event_signups.exists?(event: @event) %>
                <%= button_to event_signup_path(@event.event_name_slug, @event.event_variation_slug),
                              method: :delete,
                              class: "crayons-btn crayons-btn--outlined event-signup-btn",
                              data: { confirm: t("views.events.show.cancel_confirm") } do %>
                  <svg class="c-icon mr-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                  <%= t("views.events.show.interested_done") %>
                <% end %>
              <% else %>
                <%= button_to event_signup_path(@event.event_name_slug, @event.event_variation_slug),
                              method: :post,
                              class: "crayons-btn crayons-btn--primary event-signup-btn" do %>
                  <%= t("views.events.show.interested") %>
                <% end %>
              <% end %>
            <% else %>
              <%= link_to t("views.events.show.interested"), sign_up_path(return_to: request.fullpath), class: "crayons-btn crayons-btn--primary event-signup-btn" %>
            <% end %>
          </div>
        <% end %>
    </div>

    <% if has_stream %>
      <div class="stream-grid">
          <div class="video-wrapper" style="position: relative; background: #000; overflow: hidden; border-radius: var(--radius); min-height: 300px; display: flex; align-items: center; justify-content: center;">
              <div class="overlay-post absolute inset-0 z-10 flex flex-col items-center justify-center hidden" id="overlay-post-<%= @event.id %>" style="background: #000; color: #fff; width: 100%; height: 100%;">
                  <div class="text-xl mb-2 fw-medium"><%= t("views.events.show.starts_in") %></div>
                  <div id="countdown-post-<%= @event.id %>" class="tabular-nums text-4xl fw-bold">--:--:--</div>
              </div>
              <div class="player-container-post w-100 h-100" id="player-container-post-<%= @event.id %>" style="width: 100%; height: 100%;"></div>
          </div>

          <% chat_url = @event.data&.dig('chat_url') || @event.data&.dig(:chat_url) %>
          <% if chat_url.present? %>
            <div class="chat-wrapper">
                <iframe id="chat-frame" width="100%" height="100%" src="<%= chat_url %>" frameborder="0" title="<%= t("views.events.show.chat") %>" loading="lazy">
                </iframe>
            </div>
          <% end %>
      </div>
    <% elsif cover_image %>
      <div class="event-cover crayons-card overflow-hidden mb-4">
        <% if safe_external %>
          <a href="<%= safe_external %>" target="_blank" rel="noopener nofollow" aria-label="<%= external_label %>">
            <img src="<%= cover_image %>" alt="<%= @event.title %>" class="w-100" style="display: block; max-height: 480px; object-fit: cover;" loading="lazy">
          </a>
        <% else %>
          <img src="<%= cover_image %>" alt="<%= @event.title %>" class="w-100" style="display: block; max-height: 480px; object-fit: cover;" loading="lazy">
        <% end %>
      </div>
      <% if safe_external %>
        <div class="mb-4">
          <a href="<%= safe_external %>" target="_blank" rel="noopener nofollow" class="crayons-btn crayons-btn--l crayons-btn--primary">
            <%= external_label %>
          </a>
        </div>
      <% end %>
    <% end %>

    <div class="info-section crayons-card p-6 mt-4">
        <% if @event.description.present? %>
          <div class="mb-4 text-lg">
              <%= simple_format(@event.description) %>
          </div>
        <% end %>

        <% if @event.organization %>
          <a href="<%= organization_path(@event.organization) %>" class="profile-card">
              <img src="<%= @event.organization.profile_image_url %>" alt="<%= @event.organization.name %>">
              <div>
                  <strong><%= @event.organization.name %></strong>
                  <span>@<%= @event.organization.slug %></span>
              </div>
          </a>
        <% elsif @event.user %>
          <a href="<%= user_path(@event.user) %>" class="profile-card">
              <img src="<%= @event.user.profile_image_url %>" alt="<%= @event.user.name %>">
              <div>
                  <strong><%= @event.user.name %></strong>
                  <span>@<%= @event.user.username %></span>
              </div>
          </a>
        <% end %>

        <% if organizers.any? %>
          <div class="event-organizers mt-4">
            <h3 class="fs-s fw-bold color-base-60 mb-2"><%= t("views.events.show.organizers") %></h3>
            <ul class="list-none flex flex-wrap gap-2">
              <% organizers.each do |org| %>
                <li>
                  <% if org[:url] %>
                    <a href="<%= org[:url] %>" target="_blank" rel="noopener nofollow" class="crayons-btn crayons-btn--outlined crayons-btn--s"><%= org[:label] %></a>
                  <% else %>
                    <span class="crayons-indicator"><%= org[:label] %></span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% if social_links.any? %>
          <div class="event-socials mt-4">
            <h3 class="fs-s fw-bold color-base-60 mb-2"><%= t("views.events.show.socials") %></h3>
            <ul class="list-none flex flex-wrap gap-2">
              <% social_links.each do |link| %>
                <% next unless link[:url] %>
                <li>
                  <a href="<%= link[:url] %>" target="_blank" rel="noopener nofollow" class="crayons-btn crayons-btn--outlined crayons-btn--s"><%= link[:label] %></a>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
    </div>

    <% tag_name = @event.tags.first&.name %>

    <% if @articles.present? && @articles.any? %>
      <div class="community-header mt-8 mb-4">
          <h2 class="crayons-title">
            <% if tag_name.present? %>
              <%= t("views.events.show.community_writing", tag: tag_name.upcase) %>
            <% else %>
              <%= t("views.events.show.community_writing_generic") %>
            <% end %>
          </h2>
      </div>

      <div id="feed-container" class="feed-grid">
          <% @articles.each do |article| %>
              <article class="article-card">
                  <div class="article-user">
                      <img src="<%= article.user.profile_image_url %>" alt="<%= article.user.name %>" loading="lazy">
                      <span><%= article.user.name %></span>
                  </div>
                  <a href="<%= article.path %>" target="_blank" rel="noopener">
                      <h3 class="article-title"><%= article.title %></h3>
                  </a>
                  <div class="article-tags">
                      <% article.decorate.cached_tag_list_array.take(3).each do |tag| %>
                        <span class="tag">#<%= tag %></span>
                      <% end %>
                  </div>
                  <div class="article-meta">
                      <span><%= article.published_at&.strftime("%b %-d") %></span>
                  </div>
              </article>
          <% end %>
      </div>
    <% end %>

    <% if has_stream %>
      <script>
        (function() {
          const TARGET_TIME = new Date(<%= @event.start_time.iso8601.to_json.html_safe %>).getTime();
          const IFRAME_SRC = <%= @event.primary_stream_url.to_json.html_safe %>;
          const IS_FORCED_LIVE = <%= params[:state] == 'forced_live' %>;

          const overlay = document.getElementById("overlay-post-<%= @event.id %>");
          const countdownEl = document.getElementById("countdown-post-<%= @event.id %>");
          const playerContainer = document.getElementById("player-container-post-<%= @event.id %>");

          function update() {
            const now = Date.now();

            if (now >= TARGET_TIME || IS_FORCED_LIVE) {
              if (window.liveStreamIntervals && window.liveStreamIntervals["<%= @event.id %>"]) {
                clearInterval(window.liveStreamIntervals["<%= @event.id %>"]);
                delete window.liveStreamIntervals["<%= @event.id %>"];
              }
              if (overlay) overlay.classList.add("hidden");

              if (playerContainer && !playerContainer.querySelector("iframe")) {
                const iframe = document.createElement("iframe");

                let finalSrc = IFRAME_SRC;
                try {
                  const url = new URL(finalSrc);
                  if (url.hostname.includes("youtube.com") || url.hostname.includes("youtu.be")) {
                    url.searchParams.set("autoplay", "1");
                    url.searchParams.set("mute", "1");
                  } else if (url.hostname.includes("twitch.tv")) {
                    url.searchParams.set("autoplay", "true");
                    url.searchParams.set("muted", "true");
                  }
                  finalSrc = url.toString();
                } catch (e) {
                  // ignore
                }

                iframe.src = finalSrc;
                iframe.allow = "autoplay; fullscreen";
                iframe.allowFullscreen = true;
                iframe.setAttribute("frameborder", "0");
                iframe.setAttribute("scrolling", "no");
                iframe.style.width = "100%";
                iframe.style.height = "100%";
                playerContainer.appendChild(iframe);
              }
              return;
            }

            if (overlay) overlay.classList.remove("hidden");

            if (countdownEl) {
              const diffSeconds = Math.max(0, Math.floor((TARGET_TIME - now) / 1000));
              const hours = String(Math.floor(diffSeconds / 3600)).padStart(2, "0");
              const minutes = String(Math.floor((diffSeconds % 3600) / 60)).padStart(2, "0");
              const seconds = String(diffSeconds % 60).padStart(2, "0");
              countdownEl.textContent = `${hours}:${minutes}:${seconds}`;
            }
          }

          window.liveStreamIntervals = window.liveStreamIntervals || {};
          if (window.liveStreamIntervals["<%= @event.id %>"]) {
            clearInterval(window.liveStreamIntervals["<%= @event.id %>"]);
          }
          window.liveStreamIntervals["<%= @event.id %>"] = setInterval(update, 1000);
          update();
        })();
      </script>
    <% end %>
</div>
